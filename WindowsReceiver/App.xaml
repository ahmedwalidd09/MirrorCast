<Application x:Class="MirrorCast.Receiver.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- MirrorCast Section 6 Design System Color Palette -->
        <Color x:Key="ColorBgBase">#000000</Color>
        <Color x:Key="ColorBgSurface">#0D0D0D</Color>
        <Color x:Key="ColorBgElevated">#161616</Color>
        <Color x:Key="ColorBgHover">#1F1F1F</Color>
        <Color x:Key="ColorBgPressed">#2A2A2A</Color>
        <Color x:Key="ColorSilverBright">#C8C8CC</Color>
        <Color x:Key="ColorSilverMid">#8E8E93</Color>
        <Color x:Key="ColorSilverDim">#48484A</Color>
        <Color x:Key="ColorAccent">#E8E8ED</Color>
        <Color x:Key="ColorStreamActive">#30D158</Color>
        <Color x:Key="ColorWarn">#FF9F0A</Color>
        <Color x:Key="ColorError">#FF453A</Color>
        <Color x:Key="ColorTransparentGlass">#B80D0D0D</Color>

        <!-- SolidColorBrushes -->
        <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource ColorBgBase}" />
        <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}" />
        <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />
        <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource ColorBgHover}" />
        <SolidColorBrush x:Key="BrushBgPressed" Color="{StaticResource ColorBgPressed}" />
        <SolidColorBrush x:Key="BrushSilverBright" Color="{StaticResource ColorSilverBright}" />
        <SolidColorBrush x:Key="BrushSilverMid" Color="{StaticResource ColorSilverMid}" />
        <SolidColorBrush x:Key="BrushSilverDim" Color="{StaticResource ColorSilverDim}" />
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
        <SolidColorBrush x:Key="BrushStreamActive" Color="{StaticResource ColorStreamActive}" />
        <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColorWarn}" />
        <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
        <SolidColorBrush x:Key="BrushTransparentGlass" Color="{StaticResource ColorTransparentGlass}" />

        <!-- Base Window & Control Styles -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BrushBgBase}" />
            <Setter Property="Foreground" Value="{StaticResource BrushSilverBright}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushSilverBright}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif" />
        </Style>
    </Application.Resources>
</Application>
