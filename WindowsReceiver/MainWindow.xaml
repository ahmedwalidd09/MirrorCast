<Window x:Class="MirrorCast.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MirrorCast.Receiver.UI.Controls"
        xmlns:converters="clr-namespace:MirrorCast.Receiver.UI.Converters"
        mc:Ignorable="d"
        Title="MirrorCast"
        Height="800" Width="1080"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#000000"
        Foreground="#C8C8CC"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />

        <!-- Chrome Button Style -->
        <Style x:Key="ChromeCircleButton" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBorder"
                                Width="12" Height="12"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Toggle Button Style -->
        <Style x:Key="TabHeaderButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8C8CC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#E8E8ED" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Copy Pill Button Style -->
        <Style x:Key="PillCopyButton" TargetType="Button">
            <Setter Property="Background" Value="#161616" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#C8C8CC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F" />
                                <Setter Property="Foreground" Value="#E8E8ED" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#000000">
        <!-- TOP CUSTOM WINDOW CHROME (28px height, draggable) -->
        <Grid x:Name="CustomTitleBar"
              Height="28"
              VerticalAlignment="Top"
              Background="#0D0D0D"
              Panel.ZIndex="100"
              MouseLeftButtonDown="CustomTitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Window Icon / Tiny Brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Ellipse Width="6" Height="6" Fill="#30D158" Margin="0,0,8,0" />
                <TextBlock Text="MirrorCast"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="#8E8E93"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Center Title (Active session name if connected) -->
            <TextBlock x:Name="TitleBarDeviceText"
                       Grid.Column="1"
                       Text=""
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="11"
                       Foreground="#8E8E93" />

            <!-- Window Chrome Buttons: Minimize, Maximize, Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <!-- Minimize Button (Silver Dim) -->
                <Button Style="{StaticResource ChromeCircleButton}"
                        Background="#48484A"
                        BorderBrush="#8E8E93"
                        ToolTip="Minimize"
                        Click="MinimizeButton_Click" />
                <!-- Maximize / Restore Button (Silver Mid) -->
                <Button Style="{StaticResource ChromeCircleButton}"
                        Background="#8E8E93"
                        BorderBrush="#C8C8CC"
                        ToolTip="Maximize / Restore"
                        Click="MaximizeButton_Click" />
                <!-- Close Button (Error Red) -->
                <Button Style="{StaticResource ChromeCircleButton}"
                        Background="#FF453A"
                        BorderBrush="#FF453A"
                        ToolTip="Close"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT AREA (Offset below 28px titlebar) -->
        <Grid Margin="0,28,0,0">
            <!-- ============================================== -->
            <!-- VIEW 1: STARTUP / DISCOVERY SCREEN             -->
            <!-- ============================================== -->
            <Grid x:Name="StartupView" Background="#000000" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,48,0,24" TextBlock.TextAlignment="Center">
                    <TextBlock Text="MirrorCast"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="28"
                               FontWeight="Light"
                               Foreground="#C8C8CC"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Wireless Screen Mirroring for iOS &amp; Android"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="#8E8E93"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Connection Mode Tabs with Animated Indicator -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="#0D0D0D"
                            BorderBrush="#1F1F1F"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabIos"
                                         Content="iPhone / iPad (AirPlay)"
                                         Style="{StaticResource TabHeaderButton}"
                                         IsChecked="True"
                                         Checked="TabMode_Checked" />
                            <RadioButton x:Name="TabAndroid"
                                         Content="Android"
                                         Style="{StaticResource TabHeaderButton}"
                                         Checked="TabMode_Checked" />
                            <RadioButton x:Name="TabWifiDirect"
                                         Content="Wi-Fi Direct (No Router)"
                                         Style="{StaticResource TabHeaderButton}"
                                         Checked="TabMode_Checked" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB CONTENT CONTAINER -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- TAB 1: IPHONE / IPAD (AIRPLAY - ZERO INSTALLATION) -->
                    <Border x:Name="IosContent"
                            Background="#0D0D0D"
                            BorderBrush="#161616"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28"
                            Width="540"
                            HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Width="480">
                            <!-- Status with Pulsing Dot -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <controls:PulsingDot DotBrush="#30D158" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="AirPlay Receiver Ready: "
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#C8C8CC"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="MirrorCast"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#30D158"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Step 1 Card -->
                            <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A2A" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                        <TextBlock Text="1" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#E8E8ED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Connect to Same Wi-Fi" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8ED" />
                                        <TextBlock Text="Make sure your iPhone and this PC are on the same Wi-Fi router." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E93" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Step 2 Card -->
                            <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A2A" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                        <TextBlock Text="2" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#E8E8ED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Open Control Center" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8ED" />
                                        <TextBlock Text="Swipe down from the top-right corner of your iPhone screen." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E93" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Step 3 Card -->
                            <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A2A" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                        <TextBlock Text="3" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Tap Screen Mirroring [⧉] &gt; Select MirrorCast" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#30D158" />
                                        <TextBlock Text="Your screen and audio will instantly mirror to Windows in 60 FPS!" FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E93" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Helper Text & Refresh Button -->
                            <Grid>
                                <TextBlock Text="No app or Mac required · Native iOS AirPlay"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="#8E8E93"
                                           VerticalAlignment="Center" />
                                <Button Content="Restart AirPlay"
                                        Style="{StaticResource PillCopyButton}"
                                        HorizontalAlignment="Right"
                                        Click="RestartAirPlay_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TAB 2: ANDROID (SMART VIEW / MIRACAST - ZERO INSTALLATION) -->
                    <Border x:Name="AndroidContent"
                            Background="#0D0D0D"
                            BorderBrush="#161616"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28"
                            Width="540"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Width="480">
                            <!-- Status with Pulsing Dot -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <controls:PulsingDot DotBrush="#30D158" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Samsung &amp; Android Miracast Ready"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#C8C8CC"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Step 1 Card -->
                            <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A2A" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                        <TextBlock Text="1" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#E8E8ED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Swipe Down Quick Settings" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8ED" />
                                        <TextBlock Text="On your Samsung / Android phone, swipe down to open Quick Settings." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E93" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Step 2 Card -->
                            <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A2A" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                        <TextBlock Text="2" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#E8E8ED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Tap 'Smart View' or 'Screen Cast'" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8ED" />
                                        <TextBlock Text="Tap your PC name when it appears in the list." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E93" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Step 3 / Launch Action Card -->
                            <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Native Miracast Receiver" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#30D158" />
                                    <TextBlock Text="Launch or install the official Windows Wireless Display receiver for Smart View." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E93" Margin="0,2,0,8" />
                                    <Button Content="Launch Native Smart View Receiver"
                                            Style="{StaticResource PillCopyButton}"
                                            HorizontalAlignment="Left"
                                            Click="LaunchSmartView_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Hidden Bindings for Backwards Compatibility -->
                            <TextBlock x:Name="LocalIpAddressText" Visibility="Collapsed" />
                            <Image x:Name="WifiQrImage" Visibility="Collapsed" />

                            <!-- Helper Text -->
                            <TextBlock Text="Zero app installation required on your phone · Uses native Miracast"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="#8E8E93"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- TAB 3: WI-FI DIRECT (NO ROUTER) -->
                    <Border x:Name="WifiDirectContent"
                            Background="#0D0D0D"
                            BorderBrush="#161616"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28"
                            Width="520"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Status with Broadcasting Dot -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <controls:PulsingDot DotBrush="#30D158" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Wi-Fi Direct Soft-AP Active"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#C8C8CC"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- QR Code for Instant Wi-Fi Connection -->
                            <Border Background="#000000"
                                    BorderBrush="#1F1F1F"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Width="200" Height="200"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16">
                                <Image x:Name="DirectQrImage"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <!-- Credentials Box -->
                            <Border Background="#161616"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="0,0,0,12"
                                    Width="360">
                                <StackPanel>
                                    <!-- Network Name (SSID) -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Network"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#8E8E93"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DirectSsidText"
                                                   Text="DIRECT-MC-DESKTOP"
                                                   FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E8E8ED"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Passphrase -->
                                    <Grid>
                                        <TextBlock Text="Password"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#8E8E93"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DirectPassphraseText"
                                                   Text="aB3x9K2p"
                                                   FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#30D158"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Helper Text -->
                            <TextBlock Text="Scan with iPhone/Android camera to join Wi-Fi directly"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="#8E8E93"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- VIEW 2: STREAMING VIDEO SCREEN                 -->
            <!-- ============================================== -->
            <Grid x:Name="StreamingView" Background="#000000" Visibility="Collapsed">
                <!-- Full-Window Video Viewport with High-Quality Bilinear Interpolation -->
                <Image x:Name="VideoViewport"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Paused State Dim Overlay -->
                <Grid x:Name="PausedOverlay" Background="#99000000" Visibility="Collapsed">
                    <Border Background="#B80D0D0D"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#FF9F0A" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mirroring Paused"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#E8E8ED"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Floating Translucent Glass Toolbar HUD -->
                <controls:GlassToolbar x:Name="HudToolbar"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       ScreenshotClicked="HudToolbar_ScreenshotClicked"
                                       FullscreenClicked="HudToolbar_FullscreenClicked"
                                       DisconnectClicked="HudToolbar_DisconnectClicked" />

                <!-- Temporary Toast Banner for Screenshot Capture -->
                <Border x:Name="ToastBanner"
                        Background="#B80D0D0D"
                        BorderBrush="#30D158"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"
                              Fill="#30D158"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0" />
                        <TextBlock x:Name="ToastText"
                                   Text="Screenshot saved to Desktop"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#E8E8ED"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
