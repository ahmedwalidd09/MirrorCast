<Window x:Class="MirrorCast.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MirrorCast.Receiver.UI.Controls"
        xmlns:converters="clr-namespace:MirrorCast.Receiver.UI.Converters"
        mc:Ignorable="d"
        Title="MirrorCast"
        Height="860" Width="1140"
        MinHeight="720" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#070709"
        Foreground="#E8E8ED"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />

        <!-- Radial Ambient Background Brush -->
        <RadialGradientBrush x:Key="AmbientWindowBackground" Center="0.5,0.05" GradientOrigin="0.5,0.0" RadiusX="0.9" RadiusY="0.8">
            <GradientStop Color="#141426" Offset="0.0" />
            <GradientStop Color="#090910" Offset="0.5" />
            <GradientStop Color="#050508" Offset="1.0" />
        </RadialGradientBrush>

        <!-- Chrome Traffic Light Button Style -->
        <Style x:Key="ChromeTrafficLightButton" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBorder"
                                Width="12" Height="12"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBorder" Property="Opacity" Value="0.85" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Header RadioButton Style -->
        <Style x:Key="SegmentedTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E8E98" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8C8D2" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Tech Tactile Action Button Style -->
        <Style x:Key="TactileActionButton" TargetType="Button">
            <Setter Property="Background" Value="#121218" />
            <Setter Property="BorderBrush" Value="#262634" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E0E0E8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1C1C26" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3F3F54" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252535" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Glowing Button Style -->
        <Style x:Key="PrimaryGlowButton" TargetType="Button" BasedOn="{StaticResource TactileActionButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A2D20" Offset="0.0" />
                        <GradientStop Color="#0F1F15" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30D158" />
            <Setter Property="Foreground" Value="#30D158" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Micro Step Card Style with subtle hover elevation -->
        <Style x:Key="InteractiveStepCard" TargetType="Border">
            <Setter Property="Background" Value="#0F0F14" />
            <Setter Property="BorderBrush" Value="#1C1C26" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <!-- WINDOW LOADED STORYBOARD: Pulsing Radar Ripples & Animated Equalizer -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <!-- AirPlay Radar Ripple 1 -->
                    <DoubleAnimation Storyboard.TargetName="AirPlayPulseScale1" Storyboard.TargetProperty="ScaleX" From="1.0" To="2.5" Duration="0:0:2.0">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AirPlayPulseScale1" Storyboard.TargetProperty="ScaleY" From="1.0" To="2.5" Duration="0:0:2.0">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AirPlayPulseRing1" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:2.0" />

                    <!-- AirPlay Radar Ripple 2 (Staggered by 0.7s) -->
                    <DoubleAnimation Storyboard.TargetName="AirPlayPulseScale2" Storyboard.TargetProperty="ScaleX" From="1.0" To="2.5" Duration="0:0:2.0" BeginTime="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AirPlayPulseScale2" Storyboard.TargetProperty="ScaleY" From="1.0" To="2.5" Duration="0:0:2.0" BeginTime="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AirPlayPulseRing2" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:2.0" BeginTime="0:0:0.7" />

                    <!-- Miracast Radar Ripple 1 -->
                    <DoubleAnimation Storyboard.TargetName="MiracastPulseScale1" Storyboard.TargetProperty="ScaleX" From="1.0" To="2.5" Duration="0:0:2.0">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MiracastPulseScale1" Storyboard.TargetProperty="ScaleY" From="1.0" To="2.5" Duration="0:0:2.0">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MiracastPulseRing1" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:2.0" />

                    <!-- Miracast Radar Ripple 2 (Staggered by 0.7s) -->
                    <DoubleAnimation Storyboard.TargetName="MiracastPulseScale2" Storyboard.TargetProperty="ScaleX" From="1.0" To="2.5" Duration="0:0:2.0" BeginTime="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MiracastPulseScale2" Storyboard.TargetProperty="ScaleY" From="1.0" To="2.5" Duration="0:0:2.0" BeginTime="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MiracastPulseRing2" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:2.0" BeginTime="0:0:0.7" />

                    <!-- Simulated Audio / Stream Equalizer Bars -->
                    <DoubleAnimation Storyboard.TargetName="EqScale1" Storyboard.TargetProperty="ScaleY" From="0.3" To="1.0" Duration="0:0:0.45" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="EqScale2" Storyboard.TargetProperty="ScaleY" From="0.8" To="0.2" Duration="0:0:0.60" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="EqScale3" Storyboard.TargetProperty="ScaleY" From="0.4" To="0.9" Duration="0:0:0.50" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="EqScale4" Storyboard.TargetProperty="ScaleY" From="0.7" To="0.3" Duration="0:0:0.65" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="EqScale5" Storyboard.TargetProperty="ScaleY" From="0.2" To="0.85" Duration="0:0:0.55" AutoReverse="True" />

                    <!-- Mockup Breathing Glow -->
                    <DoubleAnimation Storyboard.TargetName="IosGlowEffect" Storyboard.TargetProperty="BlurRadius" From="4" To="14" Duration="0:0:1.6" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="AndroidGlowEffect" Storyboard.TargetProperty="BlurRadius" From="4" To="14" Duration="0:0:1.6" AutoReverse="True" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="{StaticResource AmbientWindowBackground}">
        <!-- ============================================== -->
        <!-- TOP CUSTOM WINDOW CHROME (36px height)         -->
        <!-- ============================================== -->
        <Grid x:Name="CustomTitleBar"
              Height="36"
              VerticalAlignment="Top"
              Background="#0C0C12"
              Panel.ZIndex="100"
              MouseLeftButtonDown="CustomTitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logotype & Dynamic Stream Equalizer -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Status Beacon Dot -->
                <Border Width="8" Height="8" CornerRadius="4" Background="#30D158" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#30D158" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                    </Border.Effect>
                </Border>
                <TextBlock Text="MirrorCast"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#E8E8ED"
                           VerticalAlignment="Center" />

                <!-- Dynamic Audio/Stream Spectrum Equalizer -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="12" Margin="12,0,0,0" ToolTip="Direct3D Low-Latency Stream Active">
                    <Border Width="2.5" Height="10" Background="#30D158" CornerRadius="1" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform><ScaleTransform x:Name="EqScale1" ScaleY="0.5"/></Border.RenderTransform>
                    </Border>
                    <Border Width="2.5" Height="10" Background="#30D158" CornerRadius="1" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform><ScaleTransform x:Name="EqScale2" ScaleY="0.7"/></Border.RenderTransform>
                    </Border>
                    <Border Width="2.5" Height="10" Background="#64D2FF" CornerRadius="1" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform><ScaleTransform x:Name="EqScale3" ScaleY="0.4"/></Border.RenderTransform>
                    </Border>
                    <Border Width="2.5" Height="10" Background="#0A84FF" CornerRadius="1" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform><ScaleTransform x:Name="EqScale4" ScaleY="0.8"/></Border.RenderTransform>
                    </Border>
                    <Border Width="2.5" Height="10" Background="#0A84FF" CornerRadius="1" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform><ScaleTransform x:Name="EqScale5" ScaleY="0.3"/></Border.RenderTransform>
                    </Border>
                </StackPanel>

                <Border Background="#161622" BorderBrush="#252538" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PRO DUAL-ENGINE"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#8E8E98" />
                </Border>
            </StackPanel>

            <!-- Center Active Session Display -->
            <TextBlock x:Name="TitleBarDeviceText"
                       Grid.Column="1"
                       Text="Zero-Latency Wireless Receiver Engine"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="11"
                       Foreground="#666675" />

            <!-- Window Chrome Buttons: Minimize, Maximize, Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <Button Style="{StaticResource ChromeTrafficLightButton}"
                        Background="#3E3E46"
                        BorderBrush="#555560"
                        ToolTip="Minimize"
                        Click="MinimizeButton_Click" />
                <Button Style="{StaticResource ChromeTrafficLightButton}"
                        Background="#555562"
                        BorderBrush="#777785"
                        ToolTip="Maximize / Restore"
                        Click="MaximizeButton_Click" />
                <Button Style="{StaticResource ChromeTrafficLightButton}"
                        Background="#FF453A"
                        BorderBrush="#FF453A"
                        ToolTip="Close"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT CONTAINER -->
        <Grid Margin="0,36,0,0">
            <!-- ============================================== -->
            <!-- VIEW 1: STARTUP & DISCOVERY DASHBOARD          -->
            <!-- ============================================== -->
            <Grid x:Name="StartupView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- SECTION 1: HERO & DUAL-ENGINE TELEMETRY PODS -->
                <StackPanel Grid.Row="0" Margin="0,28,0,18">
                    <!-- Brand Title & Subtitle -->
                    <TextBlock Text="MirrorCast"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="34"
                               FontWeight="Light"
                               Foreground="#F4F4F9"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Zero-Configuration Wireless Mirroring for iPhone, iPad &amp; Android"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="#8E8E98"
                               Margin="0,4,0,20"
                               HorizontalAlignment="Center" />

                    <!-- DUAL-ENGINE LIVE STATUS RADAR -->
                    <Grid HorizontalAlignment="Center" Width="760">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Pod 1: Apple AirPlay Engine -->
                        <Border Grid.Column="0"
                                Background="#0D0D14"
                                BorderBrush="#20202E"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Pulsing Concentric Radar Rings -->
                                <Grid Grid.Column="0" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="AirPlayPulseRing1" Width="10" Height="10" Stroke="#30D158" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="AirPlayPulseScale1" ScaleX="1.0" ScaleY="1.0" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="AirPlayPulseRing2" Width="10" Height="10" Stroke="#30D158" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="AirPlayPulseScale2" ScaleX="1.0" ScaleY="1.0" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Apple Minimalist Glyph Core -->
                                    <Path Data="M18.71,19.5 C17.88,20.74 17,21.95 15.66,21.97 C14.32,22 13.89,21.18 12.37,21.18 C10.84,21.18 10.37,21.95 9.1,22 C7.79,22.05 6.8,20.68 5.96,19.47 C4.25,17 2.94,12.45 4.7,9.39 C5.57,7.87 7.13,6.91 8.82,6.88 C10.1,6.86 11.32,7.75 12.11,7.75 C12.89,7.75 14.37,6.68 15.92,6.84 C16.57,6.87 18.39,7.1 19.56,8.82 C19.47,8.88 17.39,10.1 17.41,12.63 C17.44,15.65 20.06,16.66 20.09,16.67 C20.06,16.74 19.67,18.11 18.71,19.5 M15.03,4.52 C15.71,3.7 16.17,2.56 16.04,1.41 C15.06,1.45 13.87,2.06 13.17,2.88 C12.56,3.6 12.02,4.76 12.17,5.89 C13.26,5.97 14.37,5.34 15.03,4.52 Z"
                                          Fill="#30D158"
                                          Width="15" Height="18"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Apple AirPlay" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8ED" />
                                        <Border Background="#16301C" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="ACTIVE" FontFamily="Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#30D158" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="MirrorCast · Port 51279 · 60 FPS" FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Test Beacon"
                                            Style="{StaticResource TactileActionButton}"
                                            Padding="10,6"
                                            Margin="0,0,6,0"
                                            ToolTip="Verify AirPlay mDNS broadcast"
                                            Click="TestAirPlayBeacon_Click" />
                                    <Button Content="⟳"
                                            Style="{StaticResource TactileActionButton}"
                                            Padding="10,6"
                                            ToolTip="Restart AirPlay Server"
                                            Click="RestartAirPlay_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pod 2: Samsung Smart View (Miracast) -->
                        <Border Grid.Column="2"
                                Background="#0D0D14"
                                BorderBrush="#20202E"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Pulsing Concentric Radar Rings -->
                                <Grid Grid.Column="0" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="MiracastPulseRing1" Width="10" Height="10" Stroke="#0A84FF" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="MiracastPulseScale1" ScaleX="1.0" ScaleY="1.0" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="MiracastPulseRing2" Width="10" Height="10" Stroke="#0A84FF" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="MiracastPulseScale2" ScaleX="1.0" ScaleY="1.0" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Miracast Cast Glyph Core -->
                                    <Path Data="M21,3 L3,3 C1.9,3 1,3.9 1,5 L1,19 C1,20.1 1.9,21 3,21 L21,21 C22.1,21 23,20.1 23,19 L23,5 C23,3.9 22.1,3 21,3 Z M21,19 L3,19 L3,5 L21,5 L21,19 Z M8,15 L12,11 L16,15 Z"
                                          Fill="#0A84FF"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Samsung Smart View" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8ED" />
                                        <Border Background="#0F223D" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="READY" FontFamily="Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#0A84FF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Miracast · Port 7236 · D3D11 GPU" FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Test Ready"
                                            Style="{StaticResource TactileActionButton}"
                                            Padding="10,6"
                                            Margin="0,0,6,0"
                                            ToolTip="Verify Miracast Wi-Fi Direct Adapter"
                                            Click="TestMiracast_Click" />
                                    <Button Content="Canvas"
                                            Style="{StaticResource TactileActionButton}"
                                            Padding="10,6"
                                            ToolTip="Open Wireless Display Canvas"
                                            Click="LaunchSmartView_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- SECTION 2: FLOATING CAPSULE SEGMENTED SELECTOR -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border Background="#0D0D14"
                            BorderBrush="#1E1E2A"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabIos"
                                         Content="🍏 Apple iPhone / iPad"
                                         Style="{StaticResource SegmentedTabButton}"
                                         IsChecked="True"
                                         Checked="TabMode_Checked" />
                            <RadioButton x:Name="TabAndroid"
                                         Content="🤖 Samsung / Android"
                                         Style="{StaticResource SegmentedTabButton}"
                                         Checked="TabMode_Checked" />
                            <RadioButton x:Name="TabWifiDirect"
                                         Content="⚡ Wi-Fi Direct (Offline)"
                                         Style="{StaticResource SegmentedTabButton}"
                                         Checked="TabMode_Checked" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SECTION 3: INTERACTIVE PLATFORM CONTENT DECK -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- ============================================== -->
                    <!-- TAB 1: IPHONE / IPAD (AIRPLAY ZERO-INSTALL)   -->
                    <!-- ============================================== -->
                    <Border x:Name="IosContent"
                            Background="#0C0C12"
                            BorderBrush="#1C1C2A"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="28"
                            Width="760"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: 3-Step Action Sequence -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Instant Mirroring in 3 Taps"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,16" />

                                <!-- Step 1 -->
                                <Border Style="{StaticResource InteractiveStepCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1C1C26" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                                            <TextBlock Text="1" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#E0E0E8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Connect to Same Wi-Fi" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock x:Name="IosWifiSubtext" Text="Connect iPhone to same Wi-Fi router." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Copy IP" Style="{StaticResource TactileActionButton}" Padding="8,4" FontSize="11" Click="CopyIpAddress_Click" />
                                    </Grid>
                                </Border>

                                <!-- Step 2 -->
                                <Border Style="{StaticResource InteractiveStepCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1C1C26" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                                            <TextBlock Text="2" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#E0E0E8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Open Control Center" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="Swipe down from the top-right corner of your iPhone screen." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 3: Highlighted Primary Step -->
                                <Border Style="{StaticResource InteractiveStepCard}" Background="#122018" BorderBrush="#265234">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#30D158" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                                            <TextBlock Text="3" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Tap Screen Mirroring [⧉] > 'MirrorCast'" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#30D158" />
                                            <TextBlock Text="Screen &amp; audio mirror instantaneously at 60 FPS with zero lag." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Quick Test Action Strip -->
                                <Border Background="#09090E" BorderBrush="#161622" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#30D158" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="AirPlay Beacon Active on Port 51279" FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Content="⚡ Test Discovery" Style="{StaticResource TactileActionButton}" HorizontalAlignment="Right" Padding="8,4" FontSize="10" Click="TestAirPlayBeacon_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Right: Living iPhone Mockup with Breathing Glow -->
                            <Border Grid.Column="2"
                                    Background="#08080D"
                                    BorderBrush="#1C1C28"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="114" Height="206"
                                            Background="#0E0E14"
                                            BorderBrush="#333348"
                                            BorderThickness="2"
                                            CornerRadius="24"
                                            Padding="6"
                                            HorizontalAlignment="Center">
                                        <Grid>
                                            <!-- Dynamic Island -->
                                            <Border Width="32" Height="9" Background="#000000" CornerRadius="4.5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <!-- Tiny wave dot in Dynamic Island -->
                                                <Ellipse Width="3" Height="3" Fill="#30D158" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                            </Border>

                                            <!-- Control Center Mirroring Tile Simulated Glow -->
                                            <Border Width="86" Height="46"
                                                    Background="#15281E"
                                                    BorderBrush="#30D158"
                                                    BorderThickness="1.5"
                                                    CornerRadius="12"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="IosGlowEffect" Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                                </Border.Effect>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="⧉" FontSize="15" Foreground="#30D158" HorizontalAlignment="Center" />
                                                    <TextBlock Text="MirrorCast" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Zero Apps Required on Phone" FontFamily="Segoe UI" FontSize="11" FontWeight="Medium" Foreground="#30D158" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="Native Apple AirPlay Protocol" FontFamily="Segoe UI" FontSize="10" Foreground="#8E8E98" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- TAB 2: SAMSUNG / ANDROID (MIRACAST SMART VIEW)-->
                    <!-- ============================================== -->
                    <Border x:Name="AndroidContent"
                            Background="#0C0C12"
                            BorderBrush="#1C1C2A"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="28"
                            Width="760"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: 3-Step Action Sequence -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Native Samsung Smart View"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,16" />

                                <!-- Step 1 -->
                                <Border Style="{StaticResource InteractiveStepCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1C1C26" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                                            <TextBlock Text="1" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#E0E0E8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Swipe Down Quick Settings" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="Swipe down twice from top of screen to expand quick toggles." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 2 -->
                                <Border Style="{StaticResource InteractiveStepCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1C1C26" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                                            <TextBlock Text="2" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#E0E0E8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Tap 'Smart View' or 'Screen Cast'" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="Tap your PC name from the list and tap 'Start Now'." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 3: Launch Native Display Action -->
                                <Border Style="{StaticResource InteractiveStepCard}" Background="#0E1C2C" BorderBrush="#1C4270">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#0A84FF" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                                            <TextBlock Text="3" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Windows Wireless Display Receiver" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#0A84FF" />
                                            <TextBlock Text="Hardware-accelerated Miracast engine is active and ready." FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="⚡ Open Display Canvas"
                                                        Style="{StaticResource TactileActionButton}"
                                                        Background="#1A385C"
                                                        BorderBrush="#0A84FF"
                                                        Foreground="#FFFFFF"
                                                        Margin="0,0,8,0"
                                                        Click="LaunchSmartView_Click" />
                                                <Button Content="Test Ready"
                                                        Style="{StaticResource TactileActionButton}"
                                                        Padding="10,6"
                                                        Click="TestMiracast_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Hidden Bindings for Backwards Compatibility -->
                                <TextBlock x:Name="LocalIpAddressText" Visibility="Collapsed" />
                                <Image x:Name="WifiQrImage" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Right: Visual Device Mockup -->
                            <Border Grid.Column="2"
                                    Background="#08080D"
                                    BorderBrush="#1C1C28"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="114" Height="206"
                                            Background="#0E0E14"
                                            BorderBrush="#333348"
                                            BorderThickness="2"
                                            CornerRadius="20"
                                            Padding="6"
                                            HorizontalAlignment="Center">
                                        <Grid>
                                            <!-- Punch Hole Camera -->
                                            <Ellipse Width="6" Height="6" Fill="#000000" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" />

                                            <!-- Smart View Connected Glow Tile -->
                                            <Border Width="88" Height="46"
                                                    Background="#102540"
                                                    BorderBrush="#0A84FF"
                                                    BorderThickness="1.5"
                                                    CornerRadius="12"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="AndroidGlowEffect" Color="#0A84FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                                </Border.Effect>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Smart View" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" Foreground="#0A84FF" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Connected" FontFamily="Segoe UI" FontSize="8" Foreground="#8E8E98" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Zero Apps Required on Phone" FontFamily="Segoe UI" FontSize="11" FontWeight="Medium" Foreground="#0A84FF" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="Native Samsung Miracast" FontFamily="Segoe UI" FontSize="10" Foreground="#8E8E98" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- TAB 3: WI-FI DIRECT (OFFLINE SOFT-AP)          -->
                    <!-- ============================================== -->
                    <Border x:Name="WifiDirectContent"
                            Background="#0C0C12"
                            BorderBrush="#1C1C2A"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="28"
                            Width="760"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Soft-AP Network Credentials -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Wi-Fi Direct (No Router Needed)"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Ideal when traveling or without internet. Connect your phone directly to the PC's private Wi-Fi network."
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="#8E8E98"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <!-- SSID Box -->
                                <Border Style="{StaticResource InteractiveStepCard}">
                                    <Grid>
                                        <TextBlock Text="Network Name (SSID)" FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DirectSsidText"
                                                   Text="DIRECT-MC-AHMED"
                                                   FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Passphrase Box -->
                                <Border Style="{StaticResource InteractiveStepCard}">
                                    <Grid>
                                        <TextBlock Text="WPA2 Password" FontFamily="Segoe UI" FontSize="11" Foreground="#8E8E98" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DirectPassphraseText"
                                                   Text="VxQdPzWy"
                                                   FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#30D158"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Button Content="Copy Wi-Fi Direct Credentials"
                                        Style="{StaticResource TactileActionButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"
                                        Click="CopyWifiDirect_Click" />
                            </StackPanel>

                            <!-- Right: High-Res QR Code for Instant Camera Join -->
                            <Border Grid.Column="2"
                                    Background="#08080D"
                                    BorderBrush="#1C1C28"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#FFFFFF"
                                            CornerRadius="12"
                                            Padding="10"
                                            Width="160" Height="160"
                                            HorizontalAlignment="Center">
                                        <Image x:Name="DirectQrImage"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="Scan to Join Network Instantly" FontFamily="Segoe UI" FontSize="11" FontWeight="Medium" Foreground="#C8C8D2" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Text="Supported by iPhone &amp; Android camera" FontFamily="Segoe UI" FontSize="10" Foreground="#8E8E98" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 4: BOTTOM TELEMETRY FOOTER STRIP -->
                <Border Grid.Row="3"
                        Background="#08080D"
                        BorderBrush="#14141E"
                        BorderThickness="0,1,0,0"
                        Padding="24,10"
                        Margin="0,18,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#30D158" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TelemetryAdapterText"
                                       Text="Wi-Fi Interface: Intel(R) Wireless-AC 9560 (300 Mbps) · Direct3D 11/12 Low-Latency Pipeline"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="#666675"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="AirPlay + Miracast Simultaneous Active"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#8E8E98"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Button Content="Diagnostics"
                                    Style="{StaticResource TactileActionButton}"
                                    Padding="8,3"
                                    FontSize="10"
                                    Click="ShowDiagnostics_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- VIEW 2: FULL-WINDOW LIVE VIDEO VIEWPORT        -->
            <!-- ============================================== -->
            <Grid x:Name="StreamingView" Background="#000000" Visibility="Collapsed">
                <Image x:Name="VideoViewport"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Paused State Dim Overlay -->
                <Grid x:Name="PausedOverlay" Background="#99000000" Visibility="Collapsed">
                    <Border Background="#B80D0D0D"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#FF9F0A" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mirroring Paused"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#E8E8ED"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Floating Translucent Glass Toolbar HUD -->
                <controls:GlassToolbar x:Name="HudToolbar"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       ScreenshotClicked="HudToolbar_ScreenshotClicked"
                                       FullscreenClicked="HudToolbar_FullscreenClicked"
                                       DisconnectClicked="HudToolbar_DisconnectClicked" />

                <!-- Temporary Toast Banner for Screenshot Capture & Actions -->
                <Border x:Name="ToastBanner"
                        Background="#D80D0D14"
                        BorderBrush="#30D158"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"
                              Fill="#30D158"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0" />
                        <TextBlock x:Name="ToastText"
                                   Text="Screenshot saved to Desktop"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#E8E8ED"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>