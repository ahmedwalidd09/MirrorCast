<UserControl x:Class="MirrorCast.Receiver.UI.Controls.GlassToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MirrorCast.Receiver.UI.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:FpsToBrushConverter x:Key="FpsToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8C8CC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F" />
                                <Setter Property="Foreground" Value="#E8E8ED" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisconnectButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="#FF453A" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF453A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Translucent Glass Floating Pill -->
    <Border Background="#B80D0D0D"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,16,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- OS Icon (Android / iOS) -->
            <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- Android Icon -->
                <Path x:Name="AndroidIcon"
                      Fill="#8E8E93"
                      Data="M6,18 C4.9,18 4,17.1 4,16 L4,10 C4,8.9 4.9,8 6,8 L18,8 C19.1,8 20,8.9 20,10 L20,16 C20,17.1 19.1,18 18,18 L6,18 Z M8.5,13.5 C9.05,13.5 9.5,13.05 9.5,12.5 C9.5,11.95 9.05,11.5 8.5,11.5 C7.95,11.5 7.5,11.95 7.5,12.5 C7.5,13.05 7.95,13.5 8.5,13.5 Z M15.5,13.5 C16.05,13.5 16.5,13.05 16.5,12.5 C16.5,11.95 16.05,11.5 15.5,11.5 C14.95,11.5 14.5,11.95 14.5,12.5 C14.5,13.05 14.95,13.5 15.5,13.5 Z M7.8,6.2 L6.2,3.5 C6.05,3.25 6.15,2.9 6.4,2.75 C6.65,2.6 7,2.7 7.15,2.95 L8.85,5.8 C9.8,5.4 10.85,5.2 12,5.2 C13.15,5.2 14.2,5.4 15.15,5.8 L16.85,2.95 C17,2.7 17.35,2.6 17.6,2.75 C17.85,2.9 17.95,3.25 17.8,3.5 L16.2,6.2 C18.15,7.3 19.5,9.4 19.5,11.8 L4.5,11.8 C4.5,9.4 5.85,7.3 7.8,6.2 Z"
                      Stretch="Uniform" />
                <!-- Apple / iOS Icon -->
                <Path x:Name="AppleIcon"
                      Fill="#8E8E93"
                      Visibility="Collapsed"
                      Data="M18.71,19.5 C17.88,20.74 17,21.95 15.66,21.97 C14.32,22 13.89,21.18 12.37,21.18 C10.84,21.18 10.37,21.95 9.1,22 C7.79,22.05 6.8,20.68 5.96,19.47 C4.25,17 2.94,12.45 4.7,9.39 C5.57,7.87 7.13,6.91 8.82,6.88 C10.1,6.86 11.32,7.75 12.11,7.75 C12.89,7.75 14.37,6.68 15.92,6.84 C16.57,6.87 18.39,7.1 19.56,8.82 C19.47,8.88 17.39,10.1 17.41,12.63 C17.44,15.65 20.06,16.66 20.12,16.69 C20.06,16.85 19.67,18.2 18.71,19.5 Z M15.02,5.28 C15.67,4.49 16.11,3.4 15.99,2.3 C15.05,2.34 13.91,2.93 13.24,3.71 C12.64,4.4 12.12,5.52 12.26,6.59 C13.31,6.67 14.38,6.07 15.02,5.28 Z"
                      Stretch="Uniform" />
            </Grid>

            <!-- Device Name -->
            <TextBlock x:Name="DeviceNameText"
                       Text="Pixel 9 Pro"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#C8C8CC"
                       VerticalAlignment="Center" />

            <!-- Stream Mode Badge -->
            <Border Background="#161616" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="StreamModeText"
                           Text="Wi-Fi"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="#8E8E93" />
            </Border>

            <!-- Divider 1 -->
            <TextBlock Text="|" Foreground="#48484A" Margin="12,0" VerticalAlignment="Center" FontSize="12" />

            <!-- FPS Indicator with Dynamic Color -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FpsValueText"
                           Text="60"
                           FontFamily="Cascadia Code, Consolas, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30D158"
                           VerticalAlignment="Center" />
                <TextBlock Text=" FPS"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#8E8E93"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Divider 2 -->
            <TextBlock Text="|" Foreground="#48484A" Margin="12,0" VerticalAlignment="Center" FontSize="12" />

            <!-- Resolution Info -->
            <TextBlock x:Name="ResolutionText"
                       Text="1080x2400"
                       FontFamily="Cascadia Code, Consolas, Segoe UI"
                       FontSize="11"
                       Foreground="#8E8E93"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <!-- Screenshot Button -->
            <Button x:Name="ScreenshotBtn"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Save screenshot to Desktop"
                    Click="ScreenshotBtn_Click">
                <Path Data="M4,4 H7 L9,2 H15 L17,4 H20 C21.1,4 22,4.9 22,6 V18 C22,19.1 21.1,20 20,20 H4 C2.9,20 2,19.1 2,18 V6 C2,4.9 2.9,4 4,4 Z M12,17 C14.76,17 17,14.76 17,12 C17,9.24 14.76,7 12,7 C9.24,7 7,9.24 7,12 C7,14.76 9.24,17 12,17 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="16" Height="16" Stretch="Uniform" />
            </Button>

            <!-- Fullscreen Toggle Button -->
            <Button x:Name="FullscreenBtn"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Toggle fullscreen (F11)"
                    Click="FullscreenBtn_Click">
                <Path x:Name="FullscreenIcon"
                      Data="M7,14 H5 V19 H10 V17 H7 V14 Z M5,10 H7 V7 H10 V5 H5 V10 Z M17,17 H14 V19 H19 V14 H17 V17 Z M14,5 V7 H17 V10 H19 V5 H14 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="16" Height="16" Stretch="Uniform" />
            </Button>

            <!-- Disconnect Button -->
            <Button x:Name="DisconnectBtn"
                    Style="{StaticResource DisconnectButton}"
                    ToolTip="Stop mirroring and disconnect"
                    Click="DisconnectBtn_Click">
                <Path Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                      Fill="#FF453A"
                      Width="14" Height="14" Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
